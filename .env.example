# Required for the site to function
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for /ai-lab to actually respond (site works fine without it, AI Lab returns an error)
ANTHROPIC_API_KEY=

# Optional — live Airtable data instead of the static seed in src/data/airtable-seed.ts
AIRTABLE_API_KEY=

# Optional — paid checkout flow (site works without these, checkout just won't)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_ENABLED=

# Optional — canonical site URL for sitemap/robots/OG tags, defaults to https://bizhr.vercel.app
NEXT_PUBLIC_SITE_URL=
